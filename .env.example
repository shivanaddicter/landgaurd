# AI-SlopeGuard Environment Variables
# Copy to .env for local overrides

APP_NAME="AI-SlopeGuard Command Center"
ENVIRONMENT=development
PORT=8000
SECRET_KEY=aislopeguard-disaster-resilience-super-secret-key-2026

# Database (PostgreSQL + PostGIS)
# If empty, backend utilizes high-performance in-memory seed store
DATABASE_URL=postgresql://slopeguard_admin:slopeguard_password_2026@localhost:5432/slopeguard_db

# External Scientific API Keys (Optional - defaults to realistic cached feeds)
IMD_API_KEY=
ISRO_BHUVAN_TOKEN=
NRSC_SENTINEL_CREDENTIALS=
GSI_WMS_ENDPOINT=

# Telemetry
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
